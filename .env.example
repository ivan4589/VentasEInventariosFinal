DATABASE_URL="postgresql://usuario:password@localhost:5432/ventas_inventarios"
PORT=3000
NODE_ENV=development

# Genera valores reales y diferentes con:
# node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET="REEMPLAZAR_CON_UN_SECRETO_GENERADO"
TWO_FACTOR_ENCRYPTION_KEY="REEMPLAZAR_CON_OTRA_CLAVE_GENERADA"

FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"

# Cookies de sesión. En desarrollo usa lax y false.
# En producción con frontend/backend en sitios distintos usa none y true.
COOKIE_SAME_SITE="lax"
COOKIE_SECURE="false"
COOKIE_DOMAIN=""
REMEMBER_SESSION_TTL_DAYS=7
TRUST_PROXY="false"
LOG_LEVEL="info"
SERVICE_NAME="ventas-backend"

# En producción usa Supabase. La service role key solo pertenece al backend.
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PRIVATE_BUCKET="private-documents"
SUPABASE_PUBLIC_BUCKET="product-images"

# Respaldos PostgreSQL. BACKUP_DIR debe apuntar a almacenamiento persistente
# cifrado y externo al contenedor de la aplicación en producción.
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=14
PG_DUMP_BIN="pg_dump"
PG_RESTORE_BIN="pg_restore"

# Vigencia de los enlaces de correo.
EMAIL_VERIFICATION_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30

# Correo transaccional mediante Resend.
# El dominio yungasdistribuidora.cc debe estar verificado en Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="seguridad@yungasdistribuidora.cc"

# WhatsApp Cloud API. Estas credenciales pertenecen solo al backend.
# Para desarrollo puedes usar el numero de prueba y un token temporal de Meta.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_API_VERSION="v25.0"
WHATSAPP_TEMPLATE_NAME="nota_venta_pdf"
WHATSAPP_TEMPLATE_LANGUAGE="es"
WHATSAPP_DEFAULT_COUNTRY_CODE="591"
WHATSAPP_REQUEST_TIMEOUT_MS=15000

# Webhooks de Meta. Usa valores aleatorios/privados y no los publiques.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
